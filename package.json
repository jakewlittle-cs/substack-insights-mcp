{
  "name": "substack-insights-mcp",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Credential-free MCP for Substack RSS archives, immutable content history, and deterministic analytics.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakewlittle-cs/substack-insights-mcp.git"
  },
  "homepage": "https://github.com/jakewlittle-cs/substack-insights-mcp#readme",
  "bugs": {
    "url": "https://github.com/jakewlittle-cs/substack-insights-mcp/issues"
  },
  "keywords": ["mcp", "substack", "analytics", "rss", "sqlite", "newsletter"],
  "files": ["dist/src", "README.md", "LICENSE", "NOTICE"],
  "sideEffects": false,
  "bin": {
    "substack-insights": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli.ts",
    "start": "node dist/src/cli.js serve",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^5.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.1.2",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
